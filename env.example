# SPOLDER runs as a self-hosted Node/Express + PostgreSQL backend (Natro
# XCloud VPS). There is no Supabase or Vercel involved anymore, and the
# frontend needs no build-time env vars — it talks to the backend via
# same-origin relative paths (see src/integrations/supabase/client.ts, which
# despite its folder name is a small shim, not the Supabase SDK).
#
# This file documents the variables server/index.js actually reads. Copy it
# to server/.env on the VPS and fill in real values - never commit the real
# .env.

# PostgreSQL connection string for the app database.
DATABASE_URL="postgres://user:password@hostname:5432/database"

# Secret used to sign session JWTs. Must be at least 32 characters.
# Generate one with: openssl rand -base64 48
SESSION_SECRET="__GENERATE_A_LONG_RANDOM_SECRET__"

# Comma-separated list of origins allowed to call the API with credentials.
# Required whenever NODE_ENV=production.
ALLOWED_ORIGINS="https://spolder.org,https://www.spolder.org"

NODE_ENV="production"
PORT=4173

# Only used once, by server/seed-admin.js (npm run seed:admin), to create or
# reset the first admin_users row. Not read by the running server.
ADMIN_EMAIL="admin@spolder.org"
ADMIN_PASSWORD="__CHOOSE_A_STRONG_PASSWORD__"
